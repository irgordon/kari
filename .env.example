# Development-safe Compose defaults. Do not use these values in production.
DB_PASSWORD=kari_dev_database_only
JWT_SECRET=kari_development_jwt_secret_only
ENCRYPTION_KEY=
KARI_ENV=development
KARI_REQUIRE_AGENT=false
KARI_AGENT_SOCKET_DIR=./.runtime/agent
KARI_API_PORT=8080
KARI_FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional account verification, reset, and magic-link delivery. Keep secrets local.
# Public URL is the externally reachable HTTPS panel origin, without a path.
KARI_PUBLIC_URL=
KARI_SMTP_HOST=
KARI_SMTP_PORT=587
KARI_SMTP_USERNAME=
KARI_SMTP_PASSWORD=
KARI_SMTP_FROM=

# Production requires unique secret values, KARI_ENV=production,
# KARI_REQUIRE_AGENT=true, and KARI_AGENT_SOCKET_DIR=/run/kari.
