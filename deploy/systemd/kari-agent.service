[Unit]
Description=Kari privileged host agent
After=network-online.target
Wants=network-online.target
ConditionPathIsExecutable=/usr/local/libexec/kari/kari-agent

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/kari/agent.env
ExecStart=/usr/local/libexec/kari/kari-agent
Restart=on-failure
RestartSec=5s
RuntimeDirectory=kari
RuntimeDirectoryMode=0750
UMask=0027
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHostname=true
PrivateTmp=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
